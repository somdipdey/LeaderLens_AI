\f0\b\fs36 \cf2 5. Practical Leadership Scripts\
\pard\tx220\tx720\pardeftab720\li720\fi-720\partightenfactor0
\ls4\ilvl0
\fs24 \cf2 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Seeking Feedback:
\f1\b0  "I'm working on making sure my decision-making process is transparent to the team. Have you felt clear on the 'why' behind our recent shifts?"\uc0\u8232 \
\ls4\ilvl0
\f0\b \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Pausing Before Reacting:
\f1\b0  "I want to make sure I'm weighing all the variables here. Let me process this and circle back with a response by 3 PM."\uc0\u8232 \
\ls4\ilvl0
\f0\b \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Giving Credit (while owning your part):
\f1\b0  "I'm really proud of the strategy we built here. I want to specifically highlight [Name]'s execution on the data analysis, which made my final presentation possible."\uc0\u8232 \
\ls4\ilvl0
\f0\b \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Repairing Harm:
\f1\b0  "I realize my approach to that project felt too closed-off, and I see how that impacted your ability to contribute. I own that, and I'll be more inclusive earlier in the process next time."\uc0\u8232 \
\ls4\ilvl0
\f0\b \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Responding Ethically to Conflict:
\f1\b0  "It looks like our priorities are clashing here. Let's step back and look at the shared outcome we both need, rather than debating the immediate tactic."\uc0\u8232 \
\pard\pardeftab720\li4620\fi-4620\ri4620\partightenfactor0

