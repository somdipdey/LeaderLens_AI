\outl0\strokewidth0 \strokec2 explaining decision principles before announcing decisions;\
\ls14\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 applying standards consistently to allies and critics;\
\ls14\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 documenting difficult trade-offs;\
\ls14\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 inviting scrutiny of both process and outcome.\
\pard\pardeftab720\partightenfactor0
\cf0 \
\pard\pardeftab720\sa327\partightenfactor0

