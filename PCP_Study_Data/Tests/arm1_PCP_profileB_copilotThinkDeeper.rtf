\f1\b\fs32\fsmilli16380 \cf0 Possible biases to watch\
\pard\pardeftab720\sa280\partightenfactor0

\f0\b0\fs28 \cf0 These are possibilities to test, not assumptions:\
\pard\tx220\tx720\pardeftab720\li720\fi-720\sa280\partightenfactor0
\ls4\ilvl0
\f1\b \cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	1	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Outcome bias
\f0\b0 \uc0\u8232 Judging a decision mainly by whether it worked, rather than whether the process was fair, transparent, and appropriately cautious.\
\ls4\ilvl0
\f1\b \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	2	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Confidence or urgency bias
\f0\b0 \uc0\u8232 Treating speed as evidence of competence and consultation as unnecessary delay.\
\ls4\ilvl0
\f1\b \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	3	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Instrumental framing
\f0\b0 \uc0\u8232 Viewing stakeholders chiefly in terms of what they can contribute to an objective, rather than as people with legitimate interests and constraints.\
\ls4\ilvl0
\f1\b \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	4	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Selective disclosure bias
\f0\b0 \uc0\u8232 Sharing only the information needed to gain agreement, while underestimating what others reasonably need to make an informed decision.\
\ls4\ilvl0
\f1\b \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	5	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Threat-to-image bias
\f0\b0 \uc0\u8232 Becoming more defensive, controlling, or dismissive when criticism feels public, unfair, or status-relevant.\
\ls4\ilvl0
\f1\b \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	6	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Intent-impact gap
\f0\b0 \uc0\u8232 Focusing on benign intent while giving insufficient weight to how tone, timing, power differences, or public delivery affected another person.\
\pard\pardeftab720\sa327\partightenfactor0

